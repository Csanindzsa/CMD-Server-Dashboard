<UserControl x:Class="CmdDashboard.Controls.TerminalTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="320"
             d:DesignHeight="220"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border BorderBrush="#FF444444" BorderThickness="1" CornerRadius="6" Background="#FF1E1E1E" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0 0 0 8">
                <Ellipse Width="10" Height="10" Margin="0 0 6 0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TerminalStatusRunning}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Fill" Value="{StaticResource TerminalStatusStopped}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" Margin="0 0 8 0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Copy" Click="CopyButton_OnClick" Style="{StaticResource TerminalButtonStyle}" Margin="0 0 4 0"/>
                    <Button Content="Clear" Command="{Binding ClearOutputCommand}" Style="{StaticResource TerminalButtonStyle}" Margin="0 0 4 0"/>
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource TerminalButtonStyle}" Margin="0 0 4 0"/>
                    <Button Content="×"
                            Width="22" Height="22"
                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TerminalIconButtonStyle}"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="ScrollViewer">
                <TextBox Text="{Binding Output}" IsReadOnly="True" TextWrapping="Wrap" Background="#FF121212" Foreground="#FFEEEEEE" BorderThickness="0" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextChanged="OutputBox_OnTextChanged"/>
            </ScrollViewer>

            <TextBox x:Name="InputBox"
                     Grid.Row="2"
                     Margin="0 8 0 0"
                     Text="{Binding PendingInput, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="#FF121212"
                     Foreground="White"
                     BorderBrush="#FF444444"
                     BorderThickness="1"
                     Padding="4"
                     MinHeight="32"
                     AcceptsReturn="True"
                     KeyDown="InputBox_OnKeyDown"
                     Width="Auto"
                     MinWidth="120"/>
        </Grid>
    </Border>
</UserControl>
