<UserControl x:Class="CmdDashboard.Controls.TerminalTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="320"
             d:DesignHeight="220"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#FF444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="#FF1E1E1E"/>
                <Setter Property="Padding" Value="8"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsInteractive}" Value="False">
                        <Setter Property="Opacity" Value="0.55"/>
                        <Setter Property="ToolTip" Value="Run the application as administrator to interact with this terminal."/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0 0 0 8">
                <Ellipse Width="10" Height="10" Margin="0 0 6 0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TerminalStatusRunning}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Fill" Value="{StaticResource TerminalStatusStopped}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" Margin="0 0 8 0"/>
                <TextBlock Text="(Admin)"
                           Foreground="#FFEDA150"
                           FontWeight="SemiBold"
                           Margin="0 0 8 0"
                           Visibility="{Binding RunAsAdministrator, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Copy" Click="CopyButton_OnClick" Style="{StaticResource TerminalButtonStyle}" Margin="0 0 4 0"/>
                    <Button Content="Clear" Command="{Binding ClearOutputCommand}" Style="{StaticResource TerminalButtonStyle}" Margin="0 0 4 0"/>
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource TerminalButtonStyle}" Margin="0 0 4 0"/>
                    <Button Content="×"
                            Width="22" Height="22"
                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TerminalIconButtonStyle}"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="ScrollViewer">
                <TextBox Text="{Binding Output}" IsReadOnly="True" TextWrapping="Wrap" Background="#FF121212" Foreground="#FFEEEEEE" BorderThickness="0" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextChanged="OutputBox_OnTextChanged"/>
            </ScrollViewer>

            <TextBox x:Name="InputBox"
                     Grid.Row="2"
                     Margin="0 8 0 0"
                     Text="{Binding PendingInput, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="#FF121212"
                     Foreground="White"
                     BorderBrush="#FF444444"
                     BorderThickness="1"
                     Padding="4"
                     MinHeight="32"
                     AcceptsReturn="True"
                     IsEnabled="{Binding IsInteractive}"
                     PreviewKeyDown="InputBox_OnPreviewKeyDown"
                     Width="Auto"
                     MinWidth="120"/>
        </Grid>
    </Border>
</UserControl>
