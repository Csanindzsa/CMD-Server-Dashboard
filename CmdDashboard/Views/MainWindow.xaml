<Window x:Class="CmdDashboard.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CmdDashboard.Controls"
    xmlns:vm="clr-namespace:CmdDashboard.ViewModels"
        Title="Command Dashboard"
        Height="720"
        Width="1200"
        Background="#FF101010"
        FontFamily="Segoe UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0 0 0 12">
            <StackPanel Orientation="Horizontal">
                <Button Content="New Terminal"
                        Padding="16 6"
                        Margin="0 0 8 0"
                        Click="NewTerminalButton_OnClick"
                        Style="{StaticResource TerminalButtonStyle}"/>
            </StackPanel>
            <TextBlock Text="Command Dashboard"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right"/>
        </DockPanel>

        <ListBox x:Name="TerminalList"
                 Grid.Row="1"
                 ItemsSource="{Binding Sessions}"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 AllowDrop="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="TerminalList_OnPreviewMouseLeftButtonDown"
                 PreviewMouseMove="TerminalList_OnPreviewMouseMove"
                 Drop="TerminalList_OnDrop">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TerminalSessionViewModel}">
                    <controls:TerminalTile/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
